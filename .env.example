# Public application URL
NEXT_PUBLIC_APP_URL=https://ai.tatpc.ca

# Local/self-hosted image generation
# Keep this server-side. Do NOT prefix with NEXT_PUBLIC_.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_OUTPUT_PREFIX=tatpc-ai
LOCAL_AI_TIMEOUT_MS=240000
LOCAL_AI_RATE_LIMIT=10

# Optional cloud provider key used by the original Open Generative AI features.
# Leave unset if you only want the self-hosted image page.
# MUAPI_API_KEY=
